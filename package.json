{
  "name": "tradefrog",
  "version": "0.2.0",
  "description": "TRADEFROG — a paper-first Robinhood Chain trader terminal.",
  "type": "commonjs",
  "bin": {
    "tradefrog": "dist/index.js"
  },
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "check": "tsc -p tsconfig.json --noEmit",
    "dev": "tsx src/index.ts",
    "start": "node dist/index.js",
    "demo": "tsx src/index.ts --paper",
    "showcase": "tsx src/index.ts --showcase"
  },
  "engines": {
    "node": ">=20"
  },
  "devDependencies": {
    "@types/node": "^22.10.2",
    "tsx": "^4.19.2",
    "typescript": "^5.7.2"
  }
}
